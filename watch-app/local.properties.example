# Copia questo file in "local.properties" (stessa cartella, già
# ignorato da git) e compila i valori. Oltre a "sdk.dir" (aggiunto in
# automatico da Android Studio), servono le due chiavi custom lette da
# app/build.gradle.kts e iniettate come BuildConfig:

# Token del bambino generato dall'app phone (Impostazioni -> "Aggiungi
# bambino"), mostrato una volta sola al momento della creazione. Non e'
# piu' un valore statico condiviso impostato su Vercel (DEVICE_TOKEN,
# MVP a un solo bambino): il backend lo verifica per hash lookup su
# Firestore (devices/{childId}.deviceTokenHash), un token diverso per
# ogni bambino registrato — vedi CONTEXT.md, fase 1/4.
device.token=

# URL del backend, senza slash finale
backend.base.url=https://gwatch-child-tracker.vercel.app

# Facoltative, solo per generare un .aab firmato da caricare su Play
# Console (Internal Testing) — vedi app/build.gradle.kts. Il file
# .jks/.keystore indicato in release.storeFile va generato con:
#   keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias gwatch-release
# e NON va mai committato (gia' escluso da .gitignore: *.keystore, *.jks).
# Se lasciate vuote, il build "release" resta semplicemente senza firma
# (nessun impatto sui build di sviluppo/debug).
release.storeFile=
release.storePassword=
release.keyAlias=
release.keyPassword=
