    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Corpo del pin/mappa -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,24c-11.6,0 -21,9.4 -21,21c0,15.75 21,39 21,39s21,-23.25 21,-39C75,33.4 65.6,24 54,24z" />
    <!-- Pieghe della mappa, a ventaglio da un angolo -->
    <path
        android:strokeColor="#1565C0"
        android:strokeWidth="1.4"
        android:strokeAlpha="0.45"
        android:fillColor="#00000000"
        android:pathData="M38,29 L48,41" />
    <path
        android:strokeColor="#1565C0"
        android:strokeWidth="1.4"
        android:strokeAlpha="0.45"
        android:fillColor="#00000000"
        android:pathData="M38,29 L36,47" />
    <!-- Testa del bambino (grande, proporzione infantile) -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M54,47m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />
    <!-- Bustino -->
    <path
        android:fillColor="#1565C0"
