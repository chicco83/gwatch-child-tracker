     d'occhio. -->
<!-- v1.0 (2026-09-10, sostituita): al centro c'era un radar pulsante
     (due onde concentriche + punto) invece del pin.
     <path android:strokeColor="#FFFFFF" android:strokeAlpha="0.35" android:strokeWidth="2.5" android:fillColor="#00000000" android:pathData="M54,54m-16,0a16,16 0,1 1,32 0a16,16 0,1 1,-32 0" />
     <path android:strokeColor="#FFFFFF" android:strokeAlpha="0.6" android:strokeWidth="2.5" android:fillColor="#00000000" android:pathData="M54,54m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0" />
     <path android:fillColor="#FFFFFF" android:pathData="M54,54m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" /> -->
