<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- v0.20.0 (2026-09-10): allarme sonoro/vibrazione ripetuto
         sull'uscita da una zona (ExitAlarmService/ExitAlarmActivity) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- v0.25.0 (2026-09-10): l'utente segnalava che l'app doveva restare
         aperta in primo piano per ricevere le notifiche dal watch. Causa
         piu' probabile: Android (specie Samsung) sospende il processo e
         nega la sveglia di FCM ad app "ottimizzate" in background. Questo
         permesso abilita la richiesta di esenzione fatta in
         MainActivity.kt (requestIgnoreBatteryOptimizations). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".TrackerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ChildTrackerPhone">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.ChildTrackerPhone">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2026-09-24: canale e icona predefiniti per le push con payload
             "notification" (zone, SOS, posizione, batteria, stato watch)
             mostrate da Android quando l'app e' in background. Senza, il
             logcat del telefono segnalava "Missing Default Notification
             Channel metadata" e le notifiche finivano nel canale
             fcm_fallback_notification_channel ("Varie") con l'icona
             dell'app, ignorando le impostazioni del canale "alerts"
             (creato in TrackerApplication.onCreate). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <service
            android:name=".messaging.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".alarm.ExitAlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".alarm.ExitAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.ChildTrackerPhone" />

        <!-- 2026-09-18: allarme SOS che bypassa il silenzioso/DND, stesso
             pattern dell'allarme di uscita zona sopra -->
        <service
            android:name=".alarm.SosAlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".alarm.SosAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.ChildTrackerPhone" />
    </application>
</manifest>
