    <path
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.4"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M54,18m-9,0a9,9 0,1 1,18 0a9,9 0,1 1,-18 0" />
    <!-- Pallino dell'antenna -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,18m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" />
    <!-- Stelo antenna -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52,20 L56,20 L56,30 L52,30 Z" />
    <!-- Testa -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,52m-24,0a24,24 0,1 1,48 0a24,24 0,1 1,-48 0" />
    <!-- Occhio sinistro -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M45,46m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0" />
    <!-- Occhio destro -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M63,46m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0" />
    <!-- Sorriso -->
    <path
        android:strokeColor="#1565C0"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M43,58 Q54,68 65,58" />
</vector>
