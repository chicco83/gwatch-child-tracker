<!-- v1.0 (2026-09-10): Concept 12 - Mappa a tutta icona (foglio con
     bordi a zig-zag, pieghe verticali e percorso tratteggiato) come
     elemento dominante e riconoscibile; sopra, il pin (blu, per
     contrasto sul foglio bianco) con dentro il bustino a testa
     grande del bambino. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Foglio mappa, bordi a zig-zag (piega/strappo) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M14,16 L94,16 L90,34.75 L94,53.5 L90,72.25 L94,91 L14,91 L18,72.25 L14,53.5 L18,34.75 Z" />
    <!-- Pieghe verticali del foglio -->
    <path
        android:strokeColor="#1565C0"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.35"
        android:fillColor="#00000000"
        android:pathData="M40.7,18 L40.7,89" />
    <path
        android:strokeColor="#1565C0"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.35"
        android:fillColor="#00000000"
        android:pathData="M67.3,18 L67.3,89" />
    <!-- Percorso tratteggiato sulla mappa -->
    <path
        android:strokeColor="#1565C0"
        android:strokeWidth="2"
        android:strokeAlpha="0.45"
        android:fillColor="#00000000"
        android:pathData="M24,78 L30,73 M42,63 L48,58 M60,48 L66,43 M78,33 L84,28" />
    <!-- Pin (blu, per contrasto sul foglio bianco) -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M54,24c-11.6,0 -21,9.4 -21,21c0,15.75 21,39 21,39s21,-23.25 21,-39C75,33.4 65.6,24 54,24z" />
    <!-- Testa del bambino (grande, proporzione infantile) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,47m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />
    <!-- Bustino -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,68 C46,61 49,58 54,58 C59,58 62,61 62,68 Z" />
</vector>
