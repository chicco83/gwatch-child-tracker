# Copia questo file in ".env" (stessa cartella) e genera valori casuali
# lunghi per i due token, es.: openssl rand -hex 32
# ".env" e' ignorato da git (vedi .gitignore), non committare mai i
# valori reali.

# Token condiviso tra watch-app e backend, per autenticare le chiamate
# POST /ingestLocation, POST /triggerSos, GET /deviceConfig.
DEVICE_TOKEN=

# Token statico usato da Home Assistant per interrogare GET /haStatus
# (piattaforma "rest" in configuration.yaml). Livello opzionale, vedi
# CONTEXT.md: la sua assenza non deve mai bloccare il resto dell'app.
HA_STATUS_TOKEN=
