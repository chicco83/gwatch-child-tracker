# Variabili d'ambiente per il deploy su Vercel (Project Settings ->
# Environment Variables). Non committare mai i valori reali: questo
# file e' solo un template, ".env" e' ignorato da git.

# Service account Firebase (Console -> Impostazioni progetto -> Account
# di servizio -> Genera nuova chiave privata), codificata in base64 per
# evitare problemi con i newline della chiave privata:
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_B64=

# Token condiviso tra watch-app e backend (es.: openssl rand -hex 32)
DEVICE_TOKEN=

# Token statico per il polling opzionale di Home Assistant
HA_STATUS_TOKEN=

# Segreto che autentica le chiamate del Cron Job di Vercel a
# /api/cleanup (pulizia storico scaduto). Vercel lo inietta da solo
# come header "Authorization: Bearer <CRON_SECRET>" quando questa
# variabile e' impostata: non serve configurare nient'altro.
CRON_SECRET=
