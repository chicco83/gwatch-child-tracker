// Regole di sicurezza Firestore — gwatch-child-tracker
// Versione: 0.7.0
//
// Tutte le scritture "di dati" (posizione, batteria, eventi SOS)
// passano SOLO dalle funzioni backend tramite Admin SDK, che bypassa
// queste regole: qui quindi le neghiamo sempre esplicitamente.
// L'unica scrittura concessa direttamente al client e' la
// configurazione delle geofence, fatta dal genitore dalla phone-app.
//
// Multi-genitore: chiunque abbia un documento in parents/{uid} e'
// autorizzato (isParent() controlla solo che esista, non un UID
// fisso) -- per aggiungere un secondo genitore basta creare un nuovo
// documento, nessun redeploy delle regole necessario.
//
// Sicurezza: i documenti parents/{uid} possono essere CREATI solo da
// admin (Admin SDK, bypassa le regole), mai dal client. Se un client
// potesse creare il proprio documento in parents/, chiunque avesse un
// account Google generico potrebbe auto-assegnarsi l'accesso alla
// posizione del minore semplicemente autenticandosi e scrivendo il
// proprio documento. Un genitore gia' pre-autorizzato puo' solo
// leggere e aggiornare il proprio documento (es. il token FCM).
//
// Storico versioni:
// - 0.1.0 (2026-09-09): MVP a genitore singolo, UID hardcoded in
//   isParent(). Rimpiazzato per il problema di sicurezza sopra e per
//   supportare piu' genitori senza redeploy.
// - 0.3.0 (2026-09-09): aggiunta devices/{id}/quota, usata solo dal
//   backend (guardia di traffico giornaliera, vedi
//   backend/api/_lib/quota.js). Nessun client deve mai leggerla o
//   scriverla direttamente.
// - 0.4.0 (2026-09-10): aggiunta devices/{id}/messages (chat testuale
//   genitore<->watch). Scrittura sempre negata al client, a differenza
//   delle geofence: ogni messaggio deve sempre passare da un endpoint
//   backend perche' e' li' che parte anche la push FCM che sveglia il
//   destinatario (stesso motivo per cui locations/events sono
//   backend-only, vedi backend/api/trigger-event.js).
// - 0.6.0 (2026-09-11): supporto a N bambini (fase 2/4, vedi
//   CONTEXT.md) — le geofence non sono piu' annidate sotto un singolo
//   device (una zona puo' valere per piu' bambini contemporaneamente,
//   campo childIds), quindi diventano una collezione radice
//   geofences/{zoneId} invece di devices/{id}/geofences/{zoneId}.
//   Stessa condizione di prima (isParent()), solo non piu' annidata.
//   I documenti gia' esistenti nella vecchia posizione restano li' (non
//   cancellati) e vengono migrati automaticamente al primo utilizzo dal
//   backend (vedi backend/api/device-config.js) — nessun passaggio
//   manuale richiesto.
// - 0.7.0 (2026-09-22): individuato da qwen3.8-27B-UD-IQ4_XS,
//   implementato da Sonnet 5 — isolamento tra famiglie diverse sullo
//   stesso deployment. Prima isParent() bastava per leggere/scrivere
//   QUALSIASI bambino/zona/chat di QUALSIASI famiglia: bug di
//   sicurezza reale (non solo teorico) non appena una seconda famiglia
//   avesse installato l'app sullo stesso progetto Firebase — lo stesso
//   gap valeva anche lato backend (Admin SDK, vedi parent-command.js)
//   e lato push FCM (topic globale "parents", vedi
//   backend/api/trigger-event.js/send-message.js e
//   phone-app/.../TrackerApplication.kt). Ogni parents/{uid} guadagna
//   un campo "familyId" (scrivibile SOLO da backend via Admin SDK —
//   create_child/accept_family_invite in parent-command.js — MAI dal
//   client, altrimenti basterebbe indovinare/forzare l'id di
//   un'altra famiglia per unirsi). devices/{id} e geofences/{zoneId}
//   guadagnano lo stesso campo, scritto una volta alla creazione.
//   Lettura/scrittura ora richiedono myFamilyId() == familyId del
//   documento (per le subcollection di device, il familyId si legge
//   dal documento device padre con un get() dedicato, non hanno un
//   proprio campo familyId). Nuova collezione familyInvites/{code}
//   (codici di invito per un secondo genitore, TTL 24h), backend-only
//   come quota/messages. Richiede una migrazione one-time dei
//   documenti pre-esistenti (vedi backend/scripts/migrate-family-ids.js)
//   PRIMA di pubblicare questa versione delle regole — altrimenti la
//   famiglia gia' in uso perde l'accesso nella finestra fra le due
//   operazioni.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isParent() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/parents/$(request.auth.uid));
    }

    // v0.7.0: legge il proprio familyId (mai scrivibile dal client
    // direttamente, vedi allow update su parents/{parentId} sotto).
    function myFamilyId() {
      return get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.familyId;
    }

    function deviceFamilyId(deviceId) {
      return get(/databases/$(database)/documents/devices/$(deviceId)).data.familyId;
    }

    match /devices/{deviceId} {
      allow read: if isParent() && myFamilyId() == resource.data.familyId;
      allow write: if false; // solo Admin SDK via le funzioni backend

      match /locations/{locId} {
        allow read: if isParent() && myFamilyId() == deviceFamilyId(deviceId);
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if isParent() && myFamilyId() == deviceFamilyId(deviceId);
        allow write: if false;
      }

      match /quota/{dayKey} {
        allow read, write: if false; // solo Admin SDK via le funzioni backend
      }

      match /messages/{messageId} {
        allow read: if isParent() && myFamilyId() == deviceFamilyId(deviceId);
        allow write: if false; // solo Admin SDK, vedi send-message*.js
      }
    }

    match /parents/{parentId} {
      allow create: if false; // solo admin puo' pre-autorizzare un genitore
      allow read: if request.auth != null && request.auth.uid == parentId;
      // v0.7.0: familyId escluso dai campi scrivibili dal client — lo
      // scrivono solo create_child/accept_family_invite in
      // parent-command.js (Admin SDK, bypassa questa regola).
      allow update: if request.auth != null && request.auth.uid == parentId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['familyId']);
      allow delete: if false;
    }

    // v0.7.0: codici di invito per un secondo genitore — backend-only
    // (parent-command.js, create_family_invite/accept_family_invite),
    // stesso trattamento di quota/messages: mai letti/scritti dal
    // client, contengono il familyId da propagare a un nuovo genitore.
    match /familyInvites/{code} {
      allow read, write: if false;
    }

    // v0.6.0: geofence come risorsa condivisa (childIds: string[]), non
    // piu' annidata sotto un singolo device — vedi Storico versioni.
    // v0.7.0: isolata per famiglia — il client scrive ancora
    // direttamente (nessun giro dal backend, invariato), ma solo
    // dentro la propria famiglia: in creazione il familyId dichiarato
    // deve combaciare col proprio, non e' modificabile in seguito.
    match /geofences/{zoneId} {
      allow read: if isParent() && myFamilyId() == resource.data.familyId;
      allow create: if isParent() && myFamilyId() == request.resource.data.familyId;
      allow update: if isParent() && myFamilyId() == resource.data.familyId &&
        request.resource.data.familyId == resource.data.familyId;
      allow delete: if isParent() && myFamilyId() == resource.data.familyId;
    }
  }
}
