// Regole di sicurezza Firestore — gwatch-child-tracker
// Versione: 0.6.0
//
// Tutte le scritture "di dati" (posizione, batteria, eventi SOS)
// passano SOLO dalle funzioni backend tramite Admin SDK, che bypassa
// queste regole: qui quindi le neghiamo sempre esplicitamente.
// L'unica scrittura concessa direttamente al client e' la
// configurazione delle geofence, fatta dal genitore dalla phone-app.
//
// Multi-genitore: chiunque abbia un documento in parents/{uid} e'
// autorizzato (isParent() controlla solo che esista, non un UID
// fisso) -- per aggiungere un secondo genitore basta creare un nuovo
// documento, nessun redeploy delle regole necessario.
//
// Sicurezza: i documenti parents/{uid} possono essere CREATI solo da
// admin (Admin SDK, bypassa le regole), mai dal client. Se un client
// potesse creare il proprio documento in parents/, chiunque avesse un
// account Google generico potrebbe auto-assegnarsi l'accesso alla
// posizione del minore semplicemente autenticandosi e scrivendo il
// proprio documento. Un genitore gia' pre-autorizzato puo' solo
// leggere e aggiornare il proprio documento (es. il token FCM).
//
// Storico versioni:
// - 0.1.0 (2026-09-09): MVP a genitore singolo, UID hardcoded in
//   isParent(). Rimpiazzato per il problema di sicurezza sopra e per
//   supportare piu' genitori senza redeploy.
// - 0.3.0 (2026-09-09): aggiunta devices/{id}/quota, usata solo dal
//   backend (guardia di traffico giornaliera, vedi
//   backend/api/_lib/quota.js). Nessun client deve mai leggerla o
//   scriverla direttamente.
// - 0.4.0 (2026-09-10): aggiunta devices/{id}/messages (chat testuale
//   genitore<->watch). Scrittura sempre negata al client, a differenza
//   delle geofence: ogni messaggio deve sempre passare da un endpoint
//   backend perche' e' li' che parte anche la push FCM che sveglia il
//   destinatario (stesso motivo per cui locations/events sono
//   backend-only, vedi backend/api/trigger-event.js).
// - 0.6.0 (2026-09-11): supporto a N bambini (fase 2/4, vedi
//   CONTEXT.md) — le geofence non sono piu' annidate sotto un singolo
//   device (una zona puo' valere per piu' bambini contemporaneamente,
//   campo childIds), quindi diventano una collezione radice
//   geofences/{zoneId} invece di devices/{id}/geofences/{zoneId}.
//   Stessa condizione di prima (isParent()), solo non piu' annidata.
//   I documenti gia' esistenti nella vecchia posizione restano li' (non
//   cancellati) e vengono migrati automaticamente al primo utilizzo dal
//   backend (vedi backend/api/device-config.js) — nessun passaggio
//   manuale richiesto.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isParent() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/parents/$(request.auth.uid));
    }

    match /devices/{deviceId} {
      allow read: if isParent();
      allow write: if false; // solo Admin SDK via le funzioni backend

      match /locations/{locId} {
        allow read: if isParent();
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if isParent();
        allow write: if false;
      }

      match /quota/{dayKey} {
        allow read, write: if false; // solo Admin SDK via le funzioni backend
      }

      match /messages/{messageId} {
        allow read: if isParent();
        allow write: if false; // solo Admin SDK, vedi send-message*.js
      }
    }

    match /parents/{parentId} {
      allow create: if false; // solo admin puo' pre-autorizzare un genitore
      allow read, update: if request.auth != null && request.auth.uid == parentId;
      allow delete: if false;
    }

    // v0.6.0: geofence come risorsa condivisa (childIds: string[]), non
    // piu' annidata sotto un singolo device — vedi Storico versioni.
    match /geofences/{zoneId} {
      allow read, write: if isParent(); // unica scrittura diretta dal client
    }
  }
}
